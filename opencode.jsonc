{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    [
      "~/Sites/korbeil/opencode-jev-plugin/src/index.ts",
      {
        "apiKey": "apikey_REPLACE_ME",
        "model": "jev-latest",
        "policy": "strict",
        "policies": {
          "strict": { "action": 0.7, "review": 0.35, "severityBlock": 2.0 },
          "permissive": { "action": 0.85, "review": 0.35, "severityBlock": 2.0 }
        },
        "modules": { "guardrails": true, "routing": false, "compaction": false },
        "timeoutMs": 2000

        // Phase 2 — model routing: opt-in by PRESENCE of this object.
        // Deleting the block disables routing entirely.
        // "routing": {
        //   "difficultyMax": 10,
        //   "confidence": 0.70,
        //   "askOnUncertain": true,
        //   "escalateCapPerHour": 10,
        //   "tiers": [
        //     { "upTo": 2,  "model": "openai/gpt-5-mini" },
        //     { "upTo": 8,  "model": "anthropic/claude-sonnet-4-5" },
        //     { "upTo": 10, "model": "anthropic/claude-opus-4" }
        //   ]
        // }

        // Phase 3 — opt-in boolean (disabled by default); defaults shown for reference.
        // "compaction": { "keepThreshold": 0.5 }
      }
    ]
  ]
}
